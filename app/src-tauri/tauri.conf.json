{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "代敲",
  "version": "0.2.0",
  "identifier": "ai.daiqiao.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "代敲",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 15
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: shuangbin he (WDZ7982UB2)",
      "hardenedRuntime": true,
      "files": {
        "Resources/zh-CN.lproj/InfoPlist.strings": "macos/zh-CN.lproj/InfoPlist.strings",
        "Resources/zh-TW.lproj/InfoPlist.strings": "macos/zh-TW.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "macos/ja.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "macos/ko.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "macos/de.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "macos/fr.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "macos/es.lproj/InfoPlist.strings"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
